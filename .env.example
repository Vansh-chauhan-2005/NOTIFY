# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Redis & BullMQ Configuration (Optional; memory adapter activates if omitted)
REDIS_URL="redis://localhost:6379"

# MongoDB Audit Logs & User Store (Optional; memory adapter activates if omitted)
MONGODB_URI="mongodb://localhost:27017/aegis_notify"

# JWT Secret for Session Authentication (Optional; random per-boot secret if omitted)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Nodemailer SMTP Email Delivery Configuration
# Configure these to deliver real email notifications (or leaves empty to use automatic Ethereal test inbox)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Aegis Sentinel Security" <notifications@aegis-security.internal>'
ADMIN_FALLBACK_EMAIL="rajputvanshc@gmail.com"

# WebPush API VAPID Configuration for Instant Device-Level Alerts
# Leave blank to auto-generate VAPID key pairs on boot
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Fast2SMS Gateway Configuration
# Configure FAST2SMS_API_KEY to send live SMS via Fast2SMS Bulk V2 routes
FAST2SMS_API_KEY=""
FAST2SMS_TARGET_PHONE=""

# Twilio Verify SMS OTP Configuration
# Set SMS_PROVIDER="twilio" in production (mock mode is disabled when NODE_ENV=production)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
SMS_PROVIDER="mock"
MOCK_SMS_NUMBERS="+919876543210,+919000000001"
SMS_ALLOWED_COUNTRIES="+91"

# Ed25519 Root Cryptographic Authority Keys (Optional; auto-generated if omitted)
AEGIS_PUBLIC_KEY=""
AEGIS_PRIVATE_KEY=""

# Direct App Connections Encryption Key (AES-256-GCM, 32-byte hex or base64 secret)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTION_ENCRYPTION_KEY=""

# Signed Acknowledgement Link HMAC Secret (32-byte hex or random secret)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_ACK_SECRET=""

# Ephemeral Data Isolation TTL in seconds (default 300s, allowed server presets: 60, 300, 900; max 900s)
EPHEMERAL_TTL_SECONDS="300"

# Zero-Trust Ed25519 Provenance Server Signing Key (Base64 PKCS8 DER or PEM; never expose to frontend)
# Generate with: node -e "const { privateKey } = require('crypto').generateKeyPairSync('ed25519'); console.log(privateKey.export({ type: 'pkcs8', format: 'der' }).toString('base64'));"
PROVENANCE_SERVER_SIGNING_KEY=""

# Ingress Gateway & DoS Rate Limiter Configuration
# TRUST_PROXY_HOPS: Number of trusted reverse proxies in front of Express (default 1; set 0 for direct localhost without proxy)
TRUST_PROXY_HOPS="1"
# GATEWAY_IP_SALT: Secret server salt for irreversible SHA-256 IP hashing (never logged raw)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_IP_SALT=""
# Optional Upstash Redis REST adapter (free tier) to share rate-limit counters across multiple server instances
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

