    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "twilio": "^6.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.6.1"
